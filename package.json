{
  "name": "agent-kanban",
  "version": "0.0.1",
  "description": "Self-hosted kanban board shared by one human and their AI agent(s)",
  "license": "MIT",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "start": "tsx --env-file=.env src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/static": "^10.1.3",
    "@fastify/swagger": "^9.7.0",
    "@fastify/view": "^12.0.0",
    "better-sqlite3": "^12.11.1",
    "eta": "^4.6.0",
    "fastify": "^5.10.0",
    "htmx.org": "^2.0.10"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.0",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
